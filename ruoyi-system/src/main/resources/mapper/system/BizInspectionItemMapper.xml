<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.BizInspectionItemMapper">

	<resultMap type="BizInspectionItem" id="BizInspectionItemResult">
		<id     property="itemId"      column="item_id"      />
		<result property="itemName"    column="item_name"    />
		<result property="itemGroup"   column="item_group"   />
		<result property="sortOrder"   column="sort_order"   />
		<result property="status"      column="status"       />
		<result property="createBy"    column="create_by"    />
		<result property="createTime"  column="create_time"  />
		<result property="updateBy"    column="update_by"    />
		<result property="updateTime"  column="update_time"  />
		<result property="remark"      column="remark"       />
	</resultMap>

	<sql id="selectItemVo">
        select item_id, item_name, item_group, sort_order, status,
               create_by, create_time, update_by, update_time, remark
        from biz_inspection_item
    </sql>

	<select id="selectItemList" parameterType="BizInspectionItem" resultMap="BizInspectionItemResult">
	    <include refid="selectItemVo"/>
		<where>
			<if test="itemName != null and itemName != ''">
				AND item_name like concat('%', #{itemName}, '%')
			</if>
			<if test="itemGroup != null and itemGroup != ''">
				AND item_group = #{itemGroup}
			</if>
			<if test="status != null and status != ''">
				AND status = #{status}
			</if>
		</where>
		order by sort_order
	</select>

	<select id="selectItemAll" resultMap="BizInspectionItemResult">
		<include refid="selectItemVo"/>
		where status = '0'
		order by sort_order
	</select>

	<select id="selectItemById" parameterType="Long" resultMap="BizInspectionItemResult">
		<include refid="selectItemVo"/>
		where item_id = #{itemId}
	</select>

	<insert id="insertItem" parameterType="BizInspectionItem" useGeneratedKeys="true" keyProperty="itemId">
		insert into biz_inspection_item(
			<if test="itemName != null and itemName != ''">item_name,</if>
			<if test="itemGroup != null and itemGroup != ''">item_group,</if>
			<if test="sortOrder != null">sort_order,</if>
			<if test="status != null and status != ''">status,</if>
			<if test="remark != null and remark != ''">remark,</if>
			<if test="createBy != null and createBy != ''">create_by,</if>
			create_time
		)values(
			<if test="itemName != null and itemName != ''">#{itemName},</if>
			<if test="itemGroup != null and itemGroup != ''">#{itemGroup},</if>
			<if test="sortOrder != null">#{sortOrder},</if>
			<if test="status != null and status != ''">#{status},</if>
			<if test="remark != null and remark != ''">#{remark},</if>
			<if test="createBy != null and createBy != ''">#{createBy},</if>
			sysdate()
		)
	</insert>

	<update id="updateItem" parameterType="BizInspectionItem">
 		update biz_inspection_item
 		<set>
 			<if test="itemName != null and itemName != ''">item_name = #{itemName},</if>
 			<if test="itemGroup != null and itemGroup != ''">item_group = #{itemGroup},</if>
 			<if test="sortOrder != null">sort_order = #{sortOrder},</if>
 			<if test="status != null and status != ''">status = #{status},</if>
 			<if test="remark != null">remark = #{remark},</if>
 			<if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
 			update_time = sysdate()
 		</set>
 		where item_id = #{itemId}
	</update>

	<delete id="deleteItemById" parameterType="Long">
		delete from biz_inspection_item where item_id = #{itemId}
	</delete>

	<delete id="deleteItemByIds" parameterType="Long">
 		delete from biz_inspection_item where item_id in
 		<foreach collection="array" item="itemId" open="(" separator="," close=")">
 			#{itemId}
        </foreach>
 	</delete>

</mapper>
