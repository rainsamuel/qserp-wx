<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.BizPmTemplateMapper">

    <resultMap type="com.ruoyi.system.domain.BizPmTemplate" id="BizPmTemplateResult">
        <id     property="templateId"    column="template_id"    />
        <result property="templateType"  column="template_type"  />
        <result property="templateName"  column="template_name"  />
        <result property="status"        column="status"         />
        <result property="remark"        column="remark"         />
        <result property="createBy"      column="create_by"      />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"      column="update_by"      />
        <result property="updateTime"    column="update_time"    />
        <result property="contentCount"  column="content_count"  />
    </resultMap>

    <sql id="selectPmTemplateVo">
        select t.template_id, t.template_type, t.template_name, t.status, t.remark,
               t.create_by, t.create_time, t.update_by, t.update_time,
               (select count(*) from biz_pm_template_content c where c.template_id = t.template_id) as content_count
        from biz_pm_template t
    </sql>

    <select id="selectBizPmTemplateById" parameterType="Long" resultMap="BizPmTemplateResult">
        <include refid="selectPmTemplateVo"/>
        where t.template_id = #{templateId}
    </select>

    <select id="selectBizPmTemplateList" parameterType="com.ruoyi.system.domain.BizPmTemplate" resultMap="BizPmTemplateResult">
        <include refid="selectPmTemplateVo"/>
        <where>
            <if test="templateType != null and templateType != ''">
                AND t.template_type = #{templateType}
            </if>
            <if test="templateName != null and templateName != ''">
                AND t.template_name like concat('%', #{templateName}, '%')
            </if>
            <if test="status != null and status != ''">
                AND t.status = #{status}
            </if>
        </where>
        order by t.create_time desc
    </select>

    <insert id="insertBizPmTemplate" parameterType="com.ruoyi.system.domain.BizPmTemplate" useGeneratedKeys="true" keyProperty="templateId">
        insert into biz_pm_template(
            <if test="templateType != null and templateType != ''">template_type,</if>
            template_name,
            <if test="status != null and status != ''">status,</if>
            <if test="remark != null and remark != ''">remark,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            create_time
        )values(
            <if test="templateType != null and templateType != ''">#{templateType},</if>
            #{templateName},
            <if test="status != null and status != ''">#{status},</if>
            <if test="remark != null and remark != ''">#{remark},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            sysdate()
        )
    </insert>

    <update id="updateBizPmTemplate" parameterType="com.ruoyi.system.domain.BizPmTemplate">
        update biz_pm_template
        <set>
            <if test="templateType != null and templateType != ''">template_type = #{templateType},</if>
            <if test="templateName != null and templateName != ''">template_name = #{templateName},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate()
        </set>
        where template_id = #{templateId}
    </update>

    <delete id="deleteBizPmTemplateById" parameterType="Long">
        delete from biz_pm_template where template_id = #{templateId}
    </delete>

    <delete id="deleteBizPmTemplateByIds">
        delete from biz_pm_template where template_id in
        <foreach collection="array" item="templateId" open="(" separator="," close=")">
            #{templateId}
        </foreach>
    </delete>

</mapper>
