<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.BizWarehouseMapper">

	<resultMap type="BizWarehouse" id="BizWarehouseResult">
		<id     property="warehouseId"    column="warehouse_id"    />
		<result property="warehouseCode"  column="warehouse_code"  />
		<result property="warehouseName"  column="warehouse_name"  />
		<result property="address"        column="address"         />
		<result property="contactPerson"  column="contact_person"  />
		<result property="contactPhone"   column="contact_phone"   />
		<result property="status"         column="status"          />
		<result property="sourceType"     column="source_type"     />
		<result property="sourceId"       column="source_id"       />
		<result property="createBy"       column="create_by"       />
		<result property="createTime"     column="create_time"     />
		<result property="updateBy"       column="update_by"       />
		<result property="updateTime"     column="update_time"     />
		<result property="remark"         column="remark"          />
	</resultMap>

	<sql id="selectWarehouseVo">
        select warehouse_id, warehouse_code, warehouse_name, address, contact_person,
               contact_phone, status, source_type, source_id, create_by, create_time,
               update_by, update_time, remark
        from biz_warehouse
    </sql>

	<select id="selectWarehouseList" parameterType="BizWarehouse" resultMap="BizWarehouseResult">
	    <include refid="selectWarehouseVo"/>
		<where>
			<if test="warehouseCode != null and warehouseCode != ''">
				AND warehouse_code like concat('%', #{warehouseCode}, '%')
			</if>
			<if test="warehouseName != null and warehouseName != ''">
				AND warehouse_name like concat('%', #{warehouseName}, '%')
			</if>
			<if test="status != null and status != ''">
				AND status = #{status}
			</if>
			<if test="sourceType != null and sourceType != ''">
				AND source_type = #{sourceType}
			</if>
		</where>
	</select>

	<select id="selectWarehouseAll" resultMap="BizWarehouseResult">
		<include refid="selectWarehouseVo"/>
	</select>

	<select id="selectWarehouseById" parameterType="Long" resultMap="BizWarehouseResult">
		<include refid="selectWarehouseVo"/>
		where warehouse_id = #{warehouseId}
	</select>

	<select id="selectWarehouseByCode" parameterType="String" resultMap="BizWarehouseResult">
		<include refid="selectWarehouseVo"/>
		where warehouse_code = #{warehouseCode} limit 1
	</select>

	<select id="selectWarehouseBySourceId" parameterType="String" resultMap="BizWarehouseResult">
		<include refid="selectWarehouseVo"/>
		where source_id = #{sourceId} limit 1
	</select>

	<insert id="insertWarehouse" parameterType="BizWarehouse" useGeneratedKeys="true" keyProperty="warehouseId">
		insert into biz_warehouse(
			<if test="warehouseCode != null and warehouseCode != ''">warehouse_code,</if>
			<if test="warehouseName != null and warehouseName != ''">warehouse_name,</if>
			<if test="address != null and address != ''">address,</if>
			<if test="contactPerson != null and contactPerson != ''">contact_person,</if>
			<if test="contactPhone != null and contactPhone != ''">contact_phone,</if>
			<if test="status != null and status != ''">status,</if>
			<if test="sourceType != null and sourceType != ''">source_type,</if>
			<if test="sourceId != null and sourceId != ''">source_id,</if>
			<if test="remark != null and remark != ''">remark,</if>
			<if test="createBy != null and createBy != ''">create_by,</if>
			create_time
		)values(
			<if test="warehouseCode != null and warehouseCode != ''">#{warehouseCode},</if>
			<if test="warehouseName != null and warehouseName != ''">#{warehouseName},</if>
			<if test="address != null and address != ''">#{address},</if>
			<if test="contactPerson != null and contactPerson != ''">#{contactPerson},</if>
			<if test="contactPhone != null and contactPhone != ''">#{contactPhone},</if>
			<if test="status != null and status != ''">#{status},</if>
			<if test="sourceType != null and sourceType != ''">#{sourceType},</if>
			<if test="sourceId != null and sourceId != ''">#{sourceId},</if>
			<if test="remark != null and remark != ''">#{remark},</if>
			<if test="createBy != null and createBy != ''">#{createBy},</if>
			sysdate()
		)
	</insert>

	<update id="updateWarehouse" parameterType="BizWarehouse">
 		update biz_warehouse
 		<set>
 			<if test="warehouseCode != null and warehouseCode != ''">warehouse_code = #{warehouseCode},</if>
 			<if test="warehouseName != null and warehouseName != ''">warehouse_name = #{warehouseName},</if>
 			<if test="address != null">address = #{address},</if>
 			<if test="contactPerson != null">contact_person = #{contactPerson},</if>
 			<if test="contactPhone != null">contact_phone = #{contactPhone},</if>
 			<if test="status != null and status != ''">status = #{status},</if>
 			<if test="sourceType != null and sourceType != ''">source_type = #{sourceType},</if>
 			<if test="sourceId != null">source_id = #{sourceId},</if>
 			<if test="remark != null">remark = #{remark},</if>
 			<if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
 			update_time = sysdate()
 		</set>
 		where warehouse_id = #{warehouseId}
	</update>

	<delete id="deleteWarehouseById" parameterType="Long">
		delete from biz_warehouse where warehouse_id = #{warehouseId}
	</delete>

	<delete id="deleteWarehouseByIds" parameterType="Long">
 		delete from biz_warehouse where warehouse_id in
 		<foreach collection="array" item="warehouseId" open="(" separator="," close=")">
 			#{warehouseId}
        </foreach>
 	</delete>

</mapper>
