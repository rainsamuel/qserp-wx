<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.BizStockInMapper">

    <resultMap type="com.ruoyi.system.domain.BizStockIn" id="BizStockInResult">
        <result property="stockInId" column="stock_in_id"/>
        <result property="stockInNo" column="stock_in_no"/>
        <result property="supplier" column="supplier"/>
        <result property="invoiceNo" column="invoice_no"/>
        <result property="invoiceDate" column="invoice_date"/>
        <result property="invoiceAmount" column="invoice_amount"/>
        <result property="warehouseId" column="warehouse_id"/>
        <result property="warehouseName" column="warehouse_name"/>
        <result property="totalAmount" column="total_amount"/>
        <result property="totalQuantity" column="total_quantity"/>
        <result property="inDate" column="in_date"/>
        <result property="remark" column="remark"/>
        <result property="status" column="status"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="auditBy" column="audit_by"/>
        <result property="auditTime" column="audit_time"/>
        <result property="auditRemark" column="audit_remark"/>
    </resultMap>

    <sql id="selectBizStockInVo">
        select si.stock_in_id, si.stock_in_no, si.supplier, si.invoice_no, si.invoice_date,
               si.invoice_amount, si.warehouse_id, w.warehouse_name, si.total_amount, si.total_quantity,
               si.in_date, si.remark, si.status, si.create_by, si.create_time, si.update_by,
               si.update_time, si.audit_by, si.audit_time, si.audit_remark
        from biz_stock_in si
        left join biz_warehouse w on si.warehouse_id = w.warehouse_id
    </sql>

    <select id="selectBizStockInById" parameterType="Long" resultMap="BizStockInResult">
        <include refid="selectBizStockInVo"/>
        where si.stock_in_id = #{stockInId}
    </select>

    <select id="selectBizStockInList" parameterType="com.ruoyi.system.domain.BizStockIn" resultMap="BizStockInResult">
        <include refid="selectBizStockInVo"/>
        <where>
            <if test="stockInNo != null and stockInNo != ''">
                and si.stock_in_no like concat('%', #{stockInNo}, '%')
            </if>
            <if test="supplier != null and supplier != ''">
                and si.supplier like concat('%', #{supplier}, '%')
            </if>
            <if test="status != null and status != ''">
                and si.status = #{status}
            </if>
            <if test="warehouseId != null">
                and si.warehouse_id = #{warehouseId}
            </if>
            <if test="params.beginInDate != null and params.beginInDate != ''">
                and si.in_date &gt;= #{params.beginInDate}
            </if>
            <if test="params.endInDate != null and params.endInDate != ''">
                and si.in_date &lt;= #{params.endInDate}
            </if>
        </where>
        order by si.create_time desc
    </select>

    <insert id="insertBizStockIn" parameterType="com.ruoyi.system.domain.BizStockIn" useGeneratedKeys="true" keyProperty="stockInId">
        insert into biz_stock_in (
            <if test="stockInNo != null and stockInNo != ''">stock_in_no,</if>
            <if test="supplier != null and supplier != ''">supplier,</if>
            <if test="invoiceNo != null and invoiceNo != ''">invoice_no,</if>
            <if test="invoiceDate != null">invoice_date,</if>
            <if test="invoiceAmount != null">invoice_amount,</if>
            <if test="warehouseId != null">warehouse_id,</if>
            <if test="totalAmount != null">total_amount,</if>
            <if test="totalQuantity != null">total_quantity,</if>
            <if test="inDate != null">in_date,</if>
            <if test="remark != null">remark,</if>
            <if test="status != null">status,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            create_time
        )values(
            <if test="stockInNo != null and stockInNo != ''">#{stockInNo},</if>
            <if test="supplier != null and supplier != ''">#{supplier},</if>
            <if test="invoiceNo != null and invoiceNo != ''">#{invoiceNo},</if>
            <if test="invoiceDate != null">#{invoiceDate},</if>
            <if test="invoiceAmount != null">#{invoiceAmount},</if>
            <if test="warehouseId != null">#{warehouseId},</if>
            <if test="totalAmount != null">#{totalAmount},</if>
            <if test="totalQuantity != null">#{totalQuantity},</if>
            <if test="inDate != null">#{inDate},</if>
            <if test="remark != null">#{remark},</if>
            <if test="status != null">#{status},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            sysdate()
        )
    </insert>

    <update id="updateBizStockIn" parameterType="com.ruoyi.system.domain.BizStockIn">
        update biz_stock_in
        <set>
            <if test="supplier != null and supplier != ''">supplier = #{supplier},</if>
            <if test="invoiceNo != null and invoiceNo != ''">invoice_no = #{invoiceNo},</if>
            <if test="invoiceDate != null">invoice_date = #{invoiceDate},</if>
            <if test="invoiceAmount != null">invoice_amount = #{invoiceAmount},</if>
            <if test="warehouseId != null">warehouse_id = #{warehouseId},</if>
            <if test="totalAmount != null">total_amount = #{totalAmount},</if>
            <if test="totalQuantity != null">total_quantity = #{totalQuantity},</if>
            <if test="inDate != null">in_date = #{inDate},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="status != null">status = #{status},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate(),
            <if test="auditBy != null and auditBy != ''">audit_by = #{auditBy},</if>
            <if test="auditTime != null">audit_time = #{auditTime},</if>
            <if test="auditRemark != null and auditRemark != ''">audit_remark = #{auditRemark},</if>
        </set>
        where stock_in_id = #{stockInId}
    </update>

    <delete id="deleteBizStockInById" parameterType="Long">
        delete from biz_stock_in where stock_in_id = #{stockInId}
    </delete>

    <delete id="deleteBizStockInByIds" parameterType="String">
        delete from biz_stock_in where stock_in_id in
        <foreach item="stockInId" collection="array" open="(" separator="," close=")">
            #{stockInId}
        </foreach>
    </delete>

</mapper>
