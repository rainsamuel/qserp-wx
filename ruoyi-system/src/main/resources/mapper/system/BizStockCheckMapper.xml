<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.BizStockCheckMapper">

    <resultMap type="com.ruoyi.system.domain.BizStockCheck" id="BizStockCheckResult">
        <id     property="checkId"          column="check_id"          />
        <result property="checkNo"          column="check_no"          />
        <result property="warehouseId"      column="warehouse_id"      />
        <result property="warehouseName"    column="warehouse_name"    />
        <result property="checkType"        column="check_type"        />
        <result property="checkDate"        column="check_date"        />
        <result property="checker"          column="checker"           />
        <result property="status"           column="status"            />
        <result property="totalDiffAmount"  column="total_diff_amount" />
        <result property="remark"           column="remark"            />
        <result property="createBy"         column="create_by"         />
        <result property="createTime"       column="create_time"       />
        <result property="updateBy"         column="update_by"         />
        <result property="updateTime"       column="update_time"       />
    </resultMap>

    <sql id="selectStockCheckVo">
        select c.check_id, c.check_no, c.warehouse_id, w.warehouse_name,
               c.check_type, c.check_date, c.checker, c.status, c.total_diff_amount,
               c.remark, c.create_by, c.create_time, c.update_by, c.update_time
        from biz_stock_check c
        left join biz_warehouse w on c.warehouse_id = w.warehouse_id
    </sql>

    <select id="selectBizStockCheckById" parameterType="Long" resultMap="BizStockCheckResult">
        <include refid="selectStockCheckVo"/>
        where c.check_id = #{checkId}
    </select>

    <select id="selectBizStockCheckList" parameterType="com.ruoyi.system.domain.BizStockCheck" resultMap="BizStockCheckResult">
        <include refid="selectStockCheckVo"/>
        <where>
            <if test="checkNo != null and checkNo != ''">
                AND c.check_no like concat('%', #{checkNo}, '%')
            </if>
            <if test="warehouseId != null">
                AND c.warehouse_id = #{warehouseId}
            </if>
            <if test="checkType != null and checkType != ''">
                AND c.check_type = #{checkType}
            </if>
            <if test="status != null and status != ''">
                AND c.status = #{status}
            </if>
            <if test="checker != null and checker != ''">
                AND c.checker like concat('%', #{checker}, '%')
            </if>
            <if test="params.beginCheckDate != null and params.beginCheckDate != ''">
                AND c.check_date &gt;= #{params.beginCheckDate}
            </if>
            <if test="params.endCheckDate != null and params.endCheckDate != ''">
                AND c.check_date &lt;= #{params.endCheckDate}
            </if>
        </where>
        order by c.create_time desc
    </select>

    <insert id="insertBizStockCheck" parameterType="com.ruoyi.system.domain.BizStockCheck" useGeneratedKeys="true" keyProperty="checkId">
        insert into biz_stock_check(
            <if test="checkNo != null and checkNo != ''">check_no,</if>
            <if test="warehouseId != null">warehouse_id,</if>
            <if test="checkType != null and checkType != ''">check_type,</if>
            <if test="checkDate != null">check_date,</if>
            <if test="checker != null and checker != ''">checker,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="totalDiffAmount != null">total_diff_amount,</if>
            <if test="remark != null and remark != ''">remark,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            create_time
        )values(
            <if test="checkNo != null and checkNo != ''">#{checkNo},</if>
            <if test="warehouseId != null">#{warehouseId},</if>
            <if test="checkType != null and checkType != ''">#{checkType},</if>
            <if test="checkDate != null">#{checkDate},</if>
            <if test="checker != null and checker != ''">#{checker},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="totalDiffAmount != null">#{totalDiffAmount},</if>
            <if test="remark != null and remark != ''">#{remark},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            sysdate()
        )
    </insert>

    <update id="updateBizStockCheck" parameterType="com.ruoyi.system.domain.BizStockCheck">
        update biz_stock_check
        <set>
            <if test="checkNo != null and checkNo != ''">check_no = #{checkNo},</if>
            <if test="warehouseId != null">warehouse_id = #{warehouseId},</if>
            <if test="checkType != null and checkType != ''">check_type = #{checkType},</if>
            <if test="checkDate != null">check_date = #{checkDate},</if>
            <if test="checker != null and checker != ''">checker = #{checker},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="totalDiffAmount != null">total_diff_amount = #{totalDiffAmount},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate()
        </set>
        where check_id = #{checkId}
    </update>

    <delete id="deleteBizStockCheckById" parameterType="Long">
        delete from biz_stock_check where check_id = #{checkId}
    </delete>

    <delete id="deleteBizStockCheckByIds">
        delete from biz_stock_check where check_id in
        <foreach collection="array" item="checkId" open="(" separator="," close=")">
            #{checkId}
        </foreach>
    </delete>

</mapper>
