<view class="page">
  <!-- 顶部标题栏 -->
  <view class="page-header">
    <view class="header-bg"></view>
    <view class="header-content">
      <view class="header-icon"> </view>
      <view class="header-text">
        <view class="header-title">故障报修</view>
        <view class="header-desc">设备故障快速报修处理</view>
      </view>
    </view>
  </view>

  <!-- 资产信息 -->
  <view class="section-card">
    <view class="section-header">
      <view class="section-icon asset-icon"> </view>
      <text class="section-title">资产信息</text>
    </view>

    <view class="form-group">
      <view class="form-item">
        <view class="form-label-wrap">
          <text class="form-label">资产编码</text>
        </view>
        <view class="input-with-btn">
          <input class="form-input" placeholder="请输入或扫码" bindinput="onAssetCodeInput" value="{{assetCode}}" />
          <view class="scan-btn" bindtap="scanAsset">
            <text class="scan-icon"> </text>
          </view>
        </view>
      </view>

      <view class="form-item">
        <view class="form-label-wrap">
          <text class="form-label">资产名称</text>
          <text class="form-required">*</text>
        </view>
        <input class="form-input" placeholder="请输入资产名称" bindinput="onAssetNameInput" value="{{assetName}}" />
      </view>

      <view class="form-item">
        <view class="form-label-wrap">
          <text class="form-label">故障位置</text>
        </view>
        <input class="form-input" placeholder="请输入故障位置" bindinput="onLocationInput" value="{{location}}" />
      </view>
    </view>
  </view>

  <!-- 故障信息 -->
  <view class="section-card">
    <view class="section-header">
      <view class="section-icon fault-icon">⚠️</view>
      <text class="section-title">故障信息</text>
    </view>

    <view class="form-group">
      <view class="form-item">
        <view class="form-label-wrap">
          <text class="form-label">优先级</text>
        </view>
        <picker bindchange="onPriorityChange" range="{{priorityOptions}}" range-key="label" value="{{priorityIndex}}">
          <view class="picker-wrap">
            <text class="picker-text">{{priorityOptions[priorityIndex].label || '请选择优先级'}}</text>
            <text class="picker-arrow">▼</text>
          </view>
        </picker>
      </view>

      <view class="form-item column">
        <view class="form-label-wrap">
          <text class="form-label">故障描述</text>
          <text class="form-required">*</text>
        </view>
        <textarea class="remark-textarea" placeholder="请详细描述故障情况" bindinput="onFaultDescInput" value="{{faultDesc}}" />
      </view>
    </view>
  </view>

  <!-- 故障照片 -->
  <view class="section-card">
    <view class="section-header">
      <view class="section-icon photo-icon"> </view>
      <text class="section-title">故障照片</text>
      <text class="section-count">{{photos.length}}/5</text>
    </view>

    <view class="photo-grid">
      <view wx:for="{{photos}}" wx:key="index" class="photo-item">
        <image src="{{item}}" mode="aspectFill" class="photo-img" bindtap="previewPhoto" data-index="{{index}}" />
        <view class="photo-delete" catchtap="deletePhoto" data-index="{{index}}">
          <text>×</text>
        </view>
      </view>
      <view wx:if="{{photos.length < 5}}" class="photo-add" bindtap="choosePhoto">
        <text class="add-icon">+</text>
        <text class="add-text">添加照片</text>
      </view>
    </view>
  </view>

  <!-- 报修人信息 -->
  <view class="section-card">
    <view class="section-header">
      <view class="section-icon user-icon"> </view>
      <text class="section-title">报修人信息</text>
    </view>

    <view class="form-group">
      <view class="form-item">
        <view class="form-label-wrap">
          <text class="form-label">报修人</text>
          <text class="form-required">*</text>
        </view>
        <input class="form-input" placeholder="请输入报修人" bindinput="onReporterInput" value="{{reporter}}" />
      </view>

      <view class="form-item">
        <view class="form-label-wrap">
          <text class="form-label">联系电话</text>
        </view>
        <input class="form-input" placeholder="请输入联系电话" bindinput="onPhoneInput" value="{{reporterPhone}}" type="number" />
      </view>
    </view>
  </view>

  <!-- 底部按钮 -->
  <view class="bottom-bar">
    <view class="btn-group">
      <button class="my-repair-btn" bindtap="loadMyRepairs">
        <text class="my-icon"> </text>
        <text>我的报修</text>
      </button>
      <button class="submit-btn" bindtap="submitRepair">
        <text class="submit-icon"> </text>
        <text>提交报修</text>
      </button>
    </view>
  </view>

  <!-- 我的报修弹窗 -->
  <view class="popup-mask" wx:if="{{showMyRepairs}}" bindtap="closeMyRepairs">
    <view class="popup-content" catchtap="">
      <view class="popup-header">
        <view class="popup-title-wrap">
          <text class="popup-icon"> </text>
          <text class="popup-title">我的报修记录</text>
        </view>
        <text class="popup-close" bindtap="closeMyRepairs">×</text>
      </view>
      <scroll-view scroll-y class="popup-body">
        <view wx:if="{{myRepairs.length === 0}}" class="empty-state">
          <text class="empty-icon"> </text>
          <text class="empty-text">暂无报修记录</text>
        </view>
        <view wx:for="{{myRepairs}}" wx:key="repairId" class="repair-card">
          <view class="repair-top">
            <text class="repair-name">{{item.assetName}}</text>
            <view class="repair-status-tag status-{{item.status}}">
              <view class="status-dot"></view>
              <text>{{item.status === 'pending' ? '待处理' : item.status === 'processing' ? '处理中' : item.status === 'completed' ? '已完成' : item.status === 'rejected' ? '已驳回' : '已取消'}}</text>
            </view>
          </view>
          <view class="repair-info">
            <view class="repair-row">
              <text class="repair-label">故障描述</text>
              <text class="repair-value">{{item.faultDesc}}</text>
            </view>
            <view class="repair-row">
              <text class="repair-label">报修时间</text>
              <text class="repair-value">
                <text class="time-icon"> </text>
                {{item.faultTime}}
              </text>
            </view>
            <view class="repair-row" wx:if="{{item.handler}}">
              <text class="repair-label">处理人</text>
              <text class="repair-value">
                <text class="handler-icon"> ‍ </text>
                {{item.handler}}
              </text>
            </view>
            <view class="repair-row" wx:if="{{item.handleResult}}">
              <text class="repair-label">处理结果</text>
              <text class="repair-value result">{{item.handleResult}}</text>
            </view>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>
</view>
