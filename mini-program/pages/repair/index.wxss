/* 故障报修页样式 */

.page {
  min-height: 100vh;
  background: #F7F8FA;
  padding-bottom: 140rpx;
}

/* 顶部标题栏 */
.page-header {
  position: relative;
  padding: 40rpx 32rpx 32rpx;
  overflow: hidden;
}

.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, #FA8C16 0%, #FFA940 100%);
}

.header-content {
  position: relative;
  display: flex;
  align-items: center;
}

.header-icon {
  width: 80rpx;
  height: 80rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  font-size: 40rpx;
}

.header-text {
  flex: 1;
}

.header-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #FFFFFF;
  margin-bottom: 8rpx;
}

.header-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
}

/* 区域卡片 */
.section-card {
  margin: 24rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.section-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #F0F0F0;
}

.section-icon {
  width: 48rpx;
  height: 48rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  font-size: 24rpx;
}

.asset-icon {
  background: #E6F7FF;
  color: #1890FF;
}

.fault-icon {
  background: #FFF7E6;
  color: #FA8C16;
}

.photo-icon {
  background: #F9F0FF;
  color: #722ED1;
}

.user-icon {
  background: #F6FFED;
  color: #52C41A;
}

.section-title {
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
  color: #1F1F1F;
}

.section-count {
  font-size: 24rpx;
  color: #999999;
  background: #F5F5F5;
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
}

/* 表单样式 */
.form-group {
  padding: 0;
}

.form-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
}

.form-item:last-child {
  border-bottom: none;
}

.form-item.column {
  flex-direction: column;
  align-items: flex-start;
}

.form-item.column .form-label-wrap {
  margin-bottom: 16rpx;
}

.form-label-wrap {
  display: flex;
  align-items: center;
  width: 160rpx;
  flex-shrink: 0;
}

.form-label {
  font-size: 28rpx;
  color: #1F1F1F;
}

.form-required {
  color: #FF4D4F;
  margin-left: 4rpx;
}

.form-input {
  flex: 1;
  height: 72rpx;
  background: #F7F8FA;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: #1F1F1F;
}

/* 带扫码按钮的输入框 */
.input-with-btn {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.input-with-btn .form-input {
  flex: 1;
}

.scan-btn {
  width: 72rpx;
  height: 72rpx;
  background: linear-gradient(135deg, #1890FF 0%, #40A9FF 100%);
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(24, 144, 255, 0.3);
}

.scan-icon {
  font-size: 32rpx;
  color: #FFFFFF;
}

/* 选择器样式 */
.picker-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 72rpx;
  background: #F7F8FA;
  border-radius: 12rpx;
  padding: 0 20rpx;
}

.picker-text {
  font-size: 28rpx;
  color: #1F1F1F;
}

.picker-arrow {
  font-size: 24rpx;
  color: #999999;
}

/* 备注文本域 */
.remark-textarea {
  width: 100%;
  min-height: 160rpx;
  background: #F7F8FA;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  color: #1F1F1F;
  line-height: 1.6;
}

/* 照片网格 */
.photo-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.photo-item {
  position: relative;
  width: 160rpx;
  height: 160rpx;
}

.photo-img {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
}

.photo-delete {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 40rpx;
  height: 40rpx;
  background: #FF4D4F;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #FFFFFF;
  box-shadow: 0 2rpx 8rpx rgba(255, 77, 79, 0.3);
}

.photo-add {
  width: 160rpx;
  height: 160rpx;
  border: 2rpx dashed #D9D9D9;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #FAFAFA;
}

.add-icon {
  font-size: 48rpx;
  color: #999999;
  line-height: 1;
}

.add-text {
  font-size: 22rpx;
  color: #999999;
  margin-top: 8rpx;
}

/* 底部按钮 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 32rpx;
  background: #FFFFFF;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.06);
  z-index: 100;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.btn-group {
  display: flex;
  gap: 16rpx;
}

.my-repair-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  height: 88rpx;
  background: #FFFFFF;
  border: 2rpx solid #1890FF;
  border-radius: 16rpx;
  color: #1890FF;
  font-size: 28rpx;
  font-weight: 500;
}

.my-icon {
  font-size: 28rpx;
}

.submit-btn {
  flex: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  height: 88rpx;
  background: linear-gradient(135deg, #FA8C16 0%, #FFA940 100%);
  border-radius: 16rpx;
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 24rpx rgba(250, 140, 22, 0.3);
}

.submit-btn:active {
  transform: scale(0.98);
}

.submit-icon {
  font-size: 32rpx;
}

/* 弹窗样式 */
.popup-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.popup-content {
  width: 90%;
  max-height: 80vh;
  background: #FFFFFF;
  border-radius: 24rpx;
  overflow: hidden;
}

.popup-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid #F0F0F0;
}

.popup-title-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.popup-icon {
  font-size: 28rpx;
}

.popup-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1F1F1F;
}

.popup-close {
  font-size: 48rpx;
  color: #999999;
  padding: 8rpx;
  line-height: 1;
}

.popup-body {
  max-height: 65vh;
  padding: 24rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 40rpx;
}

.empty-icon {
  font-size: 64rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #CCCCCC;
}

/* 报修记录卡片 */
.repair-card {
  background: #FAFAFA;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.repair-card:last-child {
  margin-bottom: 0;
}

.repair-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.repair-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1F1F1F;
}

.repair-status-tag {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.status-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: currentColor;
}

.status-pending {
  background: #F5F5F5;
  color: #999999;
}

.status-processing {
  background: #FFF7E6;
  color: #FA8C16;
}

.status-completed {
  background: #F6FFED;
  color: #52C41A;
}

.status-rejected {
  background: #FFF2F0;
  color: #FF4D4F;
}

.status-cancelled {
  background: #F5F5F5;
  color: #666666;
}

.repair-info {
  background: #FFFFFF;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
}

.repair-row {
  display: flex;
  padding: 10rpx 0;
}

.repair-label {
  width: 140rpx;
  font-size: 24rpx;
  color: #999999;
  flex-shrink: 0;
}

.repair-value {
  flex: 1;
  font-size: 24rpx;
  color: #1F1F1F;
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.repair-value.result {
  color: #52C41A;
}

.time-icon,
.handler-icon {
  font-size: 20rpx;
}
