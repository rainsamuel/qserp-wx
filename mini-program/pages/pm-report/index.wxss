.card-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  padding-bottom: 15rpx;
  border-bottom: 1rpx solid #eee;
}
.info-row {
  display: flex;
  padding: 15rpx 0;
  border-bottom: 1rpx dashed #f0f0f0;
}
.info-row:last-child {
  border-bottom: none;
}
.label {
  width: 160rpx;
  color: #999;
  flex-shrink: 0;
}
.value {
  flex: 1;
  color: #333;
}
.form-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}
.form-label {
  width: 160rpx;
  color: #666;
  flex-shrink: 0;
}
.form-input {
  flex: 1;
}
.check-item {
  border-bottom: 1rpx solid #f5f5f5;
  padding: 15rpx 0;
}
.check-item:last-child {
  border-bottom: none;
}
.check-header {
  display: flex;
  align-items: center;
  padding: 10rpx 0;
}
.check-info {
  margin-left: 15rpx;
  flex: 1;
}
.check-name {
  font-size: 28rpx;
  color: #333;
  display: block;
}
.check-group {
  font-size: 22rpx;
  color: #999;
}
.check-detail {
  background: #f9f9f9;
  border-radius: 8rpx;
  padding: 20rpx;
  margin-top: 15rpx;
}
.detail-row {
  display: flex;
  align-items: center;
  padding: 10rpx 0;
}
.detail-label {
  width: 120rpx;
  color: #666;
  font-size: 24rpx;
}
.detail-radio {
  flex: 1;
}
.detail-input {
  flex: 1;
  font-size: 24rpx;
}
.empty {
  text-align: center;
  color: #999;
  padding: 40rpx;
}
.picker-input {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border: 1rpx solid #d9d9d9;
  border-radius: 6rpx;
  padding: 15rpx 20rpx;
  background: #fff;
}
.picker-arrow {
  font-size: 24rpx;
  color: #999;
}
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 30rpx;
  background: #fff;
  box-shadow: 0 -2rpx 8rpx rgba(0,0,0,0.1);
}
.submit-btn {
  width: 100%;
}