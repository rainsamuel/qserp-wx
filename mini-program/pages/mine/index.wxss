/* 个人中心页样式 */

.page {
  min-height: 100vh;
  background: #F7F8FA;
}

/* 用户信息卡片 */
.user-card {
  position: relative;
  padding: 60rpx 32rpx 48rpx;
  overflow: hidden;
}

.user-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, #1890FF 0%, #36CFC9 100%);
}

.user-content {
  position: relative;
  display: flex;
  align-items: center;
}

.avatar-wrap {
  position: relative;
  margin-right: 28rpx;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
}

.avatar-icon {
  font-size: 56rpx;
}

.online-dot {
  position: absolute;
  bottom: 4rpx;
  right: 4rpx;
  width: 24rpx;
  height: 24rpx;
  background: #52C41A;
  border-radius: 50%;
  border: 4rpx solid #FFFFFF;
}

.user-info {
  flex: 1;
}

.username {
  font-size: 40rpx;
  font-weight: 700;
  color: #FFFFFF;
  margin-bottom: 12rpx;
}

.user-tag {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 16rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 20rpx;
  font-size: 24rpx;
  color: #FFFFFF;
}

.tag-dot {
  width: 10rpx;
  height: 10rpx;
  background: #52C41A;
  border-radius: 50%;
}

.user-hint {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 菜单区域 */
.menu-section {
  padding: 0 24rpx;
  margin-bottom: 32rpx;
}

.menu-title {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 26rpx;
  color: #999999;
  margin-bottom: 16rpx;
  padding-left: 8rpx;
}

.menu-title-icon {
  font-size: 24rpx;
}

.menu-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid #F5F5F5;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon-wrap {
  width: 56rpx;
  height: 56rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.login-icon {
  background: #E6F7FF;
}

.login-icon .menu-icon {
  color: #1890FF;
}

.id-icon {
  background: #F6FFED;
}

.id-icon .menu-icon {
  color: #52C41A;
}

.logout-icon {
  background: #FFF2F0;
}

.logout-icon .menu-icon {
  color: #FF4D4F;
}

.about-icon {
  background: #F9F0FF;
}

.about-icon .menu-icon {
  color: #722ED1;
}

.repair-handle-icon {
  background: #FFF1F0;
}

.repair-handle-icon .menu-icon {
  color: #FF4D4F;
}

.menu-icon {
  font-size: 28rpx;
}

.menu-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.menu-text {
  flex: 1;
  font-size: 30rpx;
  color: #1F1F1F;
}

.menu-value {
  font-size: 24rpx;
  color: #999999;
}

.menu-desc {
  font-size: 24rpx;
  color: #999999;
}

.logout-text {
  color: #FF4D4F;
}

.menu-arrow {
  font-size: 32rpx;
  color: #CCCCCC;
  font-weight: 300;
}

.menu-version {
  font-size: 24rpx;
  color: #CCCCCC;
}

/* 底部版权 */
.footer {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 32rpx;
  gap: 8rpx;
}

.footer-text {
  font-size: 24rpx;
  color: #CCCCCC;
}

.footer-copyright {
  font-size: 22rpx;
  color: #E0E0E0;
}
