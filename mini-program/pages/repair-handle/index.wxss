/* 报修处理页样式 */

.page {
  min-height: 100vh;
  background: #F7F8FA;
}

/* 顶部标题栏 */
.page-header {
  position: relative;
  padding: 40rpx 32rpx 32rpx;
  overflow: hidden;
}

.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, #722ED1 0%, #B37FEB 100%);
}

.header-content {
  position: relative;
  display: flex;
  align-items: center;
}

.header-icon {
  width: 80rpx;
  height: 80rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  font-size: 40rpx;
}

.header-text {
  flex: 1;
}

.header-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #FFFFFF;
  margin-bottom: 8rpx;
}

.header-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
}

/* 标签页 */
.tab-bar {
  display: flex;
  margin: 24rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 8rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.tab-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  height: 80rpx;
  border-radius: 12rpx;
  transition: all 0.2s;
}

.tab-item.active {
  background: linear-gradient(135deg, #722ED1 0%, #B37FEB 100%);
}

.tab-text {
  font-size: 28rpx;
  font-weight: 500;
  color: #666666;
}

.tab-item.active .tab-text {
  color: #FFFFFF;
}

.tab-badge {
  min-width: 36rpx;
  height: 36rpx;
  padding: 0 8rpx;
  background: #FF4D4F;
  border-radius: 18rpx;
  font-size: 20rpx;
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tab-item.active .tab-badge {
  background: rgba(255, 255, 255, 0.3);
}

/* 列表区域 */
.list-wrap {
  padding: 0 24rpx 24rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #CCCCCC;
}

/* 报修卡片 */
.repair-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.card-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.card-priority {
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.priority-low {
  background: #F5F5F5;
  color: #666666;
}

.priority-normal {
  background: #E6F7FF;
  color: #1890FF;
}

.priority-high {
  background: #FFF7E6;
  color: #FA8C16;
}

.priority-urgent {
  background: #FFF2F0;
  color: #FF4D4F;
}

.card-time {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 24rpx;
  color: #999999;
}

.time-icon {
  font-size: 20rpx;
}

.card-status {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.card-status.processing {
  background: #FFF7E6;
  color: #FA8C16;
}

.status-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: currentColor;
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1F1F1F;
  margin-bottom: 12rpx;
}

.card-desc {
  font-size: 26rpx;
  color: #666666;
  line-height: 1.5;
  margin-bottom: 16rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.card-info {
  background: #FAFAFA;
  border-radius: 12rpx;
  padding: 16rpx;
  margin-bottom: 16rpx;
}

.info-item {
  display: flex;
  align-items: center;
}

.info-label {
  font-size: 24rpx;
  color: #999999;
  margin-right: 12rpx;
}

.info-value {
  font-size: 24rpx;
  color: #1F1F1F;
}

.card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 16rpx;
  border-top: 1rpx solid #F0F0F0;
}

.card-reporter {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: #666666;
}

.reporter-icon {
  font-size: 20rpx;
}

.card-action {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.action-text {
  font-size: 26rpx;
  color: #722ED1;
  font-weight: 500;
}

.action-arrow {
  font-size: 28rpx;
  color: #722ED1;
}

/* 弹窗样式 */
.popup-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.popup-content {
  width: 95%;
  max-height: 90vh;
  background: #FFFFFF;
  border-radius: 24rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.popup-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid #F0F0F0;
  flex-shrink: 0;
}

.popup-title-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.popup-icon {
  font-size: 28rpx;
}

.popup-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1F1F1F;
}

.popup-close {
  font-size: 48rpx;
  color: #999999;
  padding: 8rpx;
  line-height: 1;
}

.popup-body {
  flex: 1;
  padding: 24rpx;
  max-height: 60vh;
}

/* 详情区块 */
.detail-section {
  background: #FAFAFA;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1F1F1F;
  margin-bottom: 16rpx;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid #F0F0F0;
}

.detail-row {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
}

.detail-row.column {
  flex-direction: column;
  align-items: flex-start;
}

.detail-label {
  width: 140rpx;
  font-size: 26rpx;
  color: #999999;
  flex-shrink: 0;
}

.detail-value {
  flex: 1;
  font-size: 26rpx;
  color: #1F1F1F;
}

.detail-value.code {
  font-family: monospace;
  color: #1890FF;
}

.detail-value.desc {
  margin-top: 8rpx;
  line-height: 1.6;
}

.detail-value.phone {
  color: #1890FF;
  text-decoration: underline;
}

.priority-tag {
  display: inline-block;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
}

/* 照片网格 */
.photo-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.photo-item {
  width: 150rpx;
  height: 150rpx;
  border-radius: 12rpx;
}

/* 处理操作区域 */
.handle-section {
  background: #F6FFED;
  border: 2rpx solid #B7EB8F;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.handle-section .section-title {
  color: #52C41A;
  border-bottom-color: #D9F7BE;
}

/* 状态选择 */
.status-options {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.status-option {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 24rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
  border: 2rpx solid #E0E0E0;
  background: #FFFFFF;
  transition: all 0.2s;
}

.option-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  border: 2rpx solid #D9D9D9;
  transition: all 0.2s;
}

.status-option.status-processing {
  border-color: #FFD591;
  color: #FA8C16;
}

.status-option.status-processing .option-dot {
  border-color: #FA8C16;
}

.status-option.status-processing.selected {
  background: #FFF7E6;
  border-color: #FA8C16;
}

.status-option.status-processing.selected .option-dot {
  background: #FA8C16;
}

.status-option.status-completed {
  border-color: #B7EB8F;
  color: #52C41A;
}

.status-option.status-completed .option-dot {
  border-color: #52C41A;
}

.status-option.status-completed.selected {
  background: #F6FFED;
  border-color: #52C41A;
}

.status-option.status-completed.selected .option-dot {
  background: #52C41A;
}

.status-option.status-rejected {
  border-color: #FFA39E;
  color: #FF4D4F;
}

.status-option.status-rejected .option-dot {
  border-color: #FF4D4F;
}

.status-option.status-rejected.selected {
  background: #FFF2F0;
  border-color: #FF4D4F;
}

.status-option.status-rejected.selected .option-dot {
  background: #FF4D4F;
}

/* 处理输入 */
.handle-input-wrap {
  margin-top: 16rpx;
}

.handle-label {
  display: block;
  font-size: 26rpx;
  color: #1F1F1F;
  font-weight: 500;
  margin-bottom: 12rpx;
}

.handle-input {
  width: 100%;
  height: 80rpx;
  background: #FFFFFF;
  border: 2rpx solid #E0E0E0;
  border-radius: 12rpx;
  padding: 0 16rpx;
  font-size: 26rpx;
  color: #1F1F1F;
  box-sizing: border-box;
}

/* 底部按钮 */
.popup-footer {
  display: flex;
  gap: 16rpx;
  padding: 24rpx 32rpx;
  border-top: 1rpx solid #F0F0F0;
  flex-shrink: 0;
}

.cancel-btn {
  flex: 1;
  height: 80rpx;
  background: #FFFFFF;
  border: 2rpx solid #D9D9D9;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #666666;
  display: flex;
  align-items: center;
  justify-content: center;
}

.submit-btn {
  flex: 2;
  height: 80rpx;
  background: linear-gradient(135deg, #722ED1 0%, #B37FEB 100%);
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(114, 46, 209, 0.3);
}

.submit-btn:active {
  transform: scale(0.98);
}
