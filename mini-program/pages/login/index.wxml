<view class="login-container">
  <view class="login-header">
    <view class="logo"> </view>
    <view class="title">资产管理系统</view>
    <view class="subtitle">请使用工号登录</view>
  </view>

  <view class="login-form">
    <view class="form-item">
      <view class="input-wrapper">
        <text class="input-icon"> </text>
        <input class="input" placeholder="请输入工号" bindinput="onUsernameInput" value="{{username}}" />
      </view>
    </view>
    <view class="form-item">
      <view class="input-wrapper">
        <text class="input-icon"> </text>
        <input class="input" placeholder="请输入密码" password bindinput="onPasswordInput" value="{{password}}" />
      </view>
    </view>
    <button class="login-btn" bindtap="handleLogin" loading="{{loading}}">登 录</button>
  </view>
</view>