.login-container {
  min-height: 100vh;
  background: linear-gradient(135deg, #1890ff 0%, #36cfc9 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 60rpx;
}
.login-header {
  text-align: center;
  margin-bottom: 80rpx;
}
.logo {
  font-size: 100rpx;
  margin-bottom: 20rpx;
}
.title {
  font-size: 48rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 15rpx;
}
.subtitle {
  font-size: 28rpx;
  color: rgba(255,255,255,0.8);
}
.login-form {
  width: 100%;
  background: #fff;
  border-radius: 20rpx;
  padding: 50rpx 40rpx;
  box-shadow: 0 10rpx 40rpx rgba(0,0,0,0.1);
}
.form-item {
  margin-bottom: 40rpx;
}
.input-wrapper {
  display: flex;
  align-items: center;
  border: 2rpx solid #e8e8e8;
  border-radius: 12rpx;
  padding: 0 25rpx;
  height: 90rpx;
  transition: border-color 0.3s;
}
.input-wrapper:focus-within {
  border-color: #1890ff;
}
.input-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
  color: #999;
}
.input {
  flex: 1;
  font-size: 30rpx;
  height: 100%;
}
.login-btn {
  width: 100%;
  height: 90rpx;
  background: #1890ff;
  color: #fff;
  font-size: 32rpx;
  border-radius: 12rpx;
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.login-btn[disabled] {
  background: #a0cfff;
}