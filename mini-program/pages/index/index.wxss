.title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  text-align: center;
  margin-bottom: 20rpx;
}
.desc {
  font-size: 28rpx;
  color: #666;
  text-align: center;
}
.card-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}
.input-group {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.input-group .input {
  flex: 1;
}
.btn-sm {
  background-color: #1890ff;
  color: #fff;
  font-size: 28rpx;
  padding: 15rpx 30rpx;
  border-radius: 6rpx;
  line-height: 1.2;
}
.btn-primary {
  background-color: #1890ff;
  color: #fff;
  border-radius: 8rpx;
}
.btn-success {
  background-color: #52c41a;
  color: #fff;
  border-radius: 8rpx;
}