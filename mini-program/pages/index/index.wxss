/* 首页样式 */

.page {
  min-height: 100vh;
  background-color: var(--color-bg-page);
  padding-bottom: 40rpx;
}

/* 顶部 Banner */
.banner {
  position: relative;
  margin: 24rpx;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 32rpx rgba(24, 144, 255, 0.2);
}

.banner-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, #1890FF 0%, #36CFC9 100%);
}

.banner-content {
  position: relative;
  display: flex;
  align-items: center;
  padding: 40rpx 32rpx 32rpx;
}

.banner-icon {
  width: 80rpx;
  height: 80rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}

.banner-icon .iconfont {
  font-size: 40rpx;
  color: #FFFFFF;
}

.banner-text {
  flex: 1;
}

.banner-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #FFFFFF;
  margin-bottom: 8rpx;
}

.banner-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
}

.banner-stats {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 24rpx 32rpx;
  background: rgba(255, 255, 255, 0.15);
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.stat-icon {
  font-size: 36rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #FFFFFF;
}

.stat-divider {
  width: 1rpx;
  height: 40rpx;
  background: rgba(255, 255, 255, 0.3);
}

/* 功能入口 */
.section {
  padding: 0 24rpx;
}

.func-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

/* 扫码按钮区域 */
.scan-btn-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  height: 72rpx;
  margin-top: 16rpx;
  background: #FAFAFA;
  border-radius: 12rpx;
  border: 1rpx dashed #E0E0E0;
}

.scan-btn-wrap:active {
  background: #F0F0F0;
}

.scan-icon {
  font-size: 28rpx;
}

.scan-text {
  font-size: 26rpx;
  color: #666666;
}

.func-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.func-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.func-icon {
  font-size: 36rpx;
}

.func-info {
  flex: 1;
}

.func-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1F1F1F;
  margin-bottom: 6rpx;
}

.func-desc {
  font-size: 24rpx;
  color: #999999;
}

.func-arrow {
  font-size: 40rpx;
  color: #CCCCCC;
  font-weight: 300;
}

/* 输入区域 */
.func-input-wrap {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.input-box {
  flex: 1;
  display: flex;
  align-items: center;
  height: 72rpx;
  background: #F7F8FA;
  border-radius: 12rpx;
  padding: 0 20rpx;
}

.input-prefix {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.input-box .input {
  flex: 1;
  height: 100%;
  font-size: 28rpx;
  color: #1F1F1F;
}

.func-btn {
  height: 72rpx;
  padding: 0 32rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 500;
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  white-space: nowrap;
}

/* 蓝色主题 - 资产查询 */
.query-bg {
  background: linear-gradient(135deg, #E6F7FF 0%, #BAE7FF 100%);
}

.query-bg .func-icon,
.query-icon {
  color: #1890FF;
}

.query-btn {
  background: linear-gradient(135deg, #1890FF 0%, #40A9FF 100%);
  box-shadow: 0 4rpx 12rpx rgba(24, 144, 255, 0.3);
}

/* 绿色主题 - PM维护 */
.pm-bg {
  background: linear-gradient(135deg, #F6FFED 0%, #D9F7BE 100%);
}

.pm-bg .func-icon,
.pm-icon {
  color: #52C41A;
}

.pm-btn {
  background: linear-gradient(135deg, #52C41A 0%, #73D13D 100%);
  box-shadow: 0 4rpx 12rpx rgba(82, 196, 26, 0.3);
}

/* 橙色主题 - 故障报修 */
.repair-bg {
  background: linear-gradient(135deg, #FFF7E6 0%, #FFE7BA 100%);
}

.repair-bg .func-icon,
.repair-icon {
  color: #FA8C16;
}

.repair-btn {
  background: linear-gradient(135deg, #FA8C16 0%, #FFA940 100%);
  box-shadow: 0 4rpx 12rpx rgba(250, 140, 22, 0.3);
}

/* 底部提示 */
.footer {
  text-align: center;
  padding: 32rpx;
}

.footer-text {
  font-size: 24rpx;
  color: #CCCCCC;
}
