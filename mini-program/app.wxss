page {
  background-color: #f5f5f5;
  font-size: 28rpx;
}
.container {
  padding: 30rpx;
}
.btn-primary {
  background-color: #1890ff;
  color: #fff;
  border-radius: 8rpx;
  padding: 20rpx 40rpx;
  text-align: center;
}
.btn-success {
  background-color: #52c41a;
  color: #fff;
  border-radius: 8rpx;
  padding: 20rpx 40rpx;
  text-align: center;
}
.card {
  background: #fff;
  border-radius: 12rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.1);
}
.form-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #eee;
}
.form-label {
  width: 180rpx;
  color: #666;
}
.form-input {
  flex: 1;
  padding: 10rpx;
}
.input {
  border: 1rpx solid #d9d9d9;
  border-radius: 6rpx;
  padding: 15rpx 20rpx;
  width: 100%;
  box-sizing: border-box;
}
.textarea {
  border: 1rpx solid #d9d9d9;
  border-radius: 6rpx;
  padding: 15rpx 20rpx;
  width: 100%;
  height: 200rpx;
  box-sizing: border-box;
}