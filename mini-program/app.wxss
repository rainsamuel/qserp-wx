/* 导入全局设计变量 */
@import './styles/variables.wxss';

/* 全局基础样式 */
page {
  background-color: #F7F8FA;
  font-size: 28rpx;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', 'Microsoft YaHei', sans-serif;
  color: #1F1F1F;
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}

/* 安全区域适配 */
.safe-area-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}

/* 全局滚动优化 */
scroll-view {
  -webkit-overflow-scrolling: touch;
}

/* 全局按钮重置 */
button {
  margin: 0;
  padding: 0;
  line-height: inherit;
  font-size: inherit;
  color: inherit;
  background: none;
  border: none;
  border-radius: 0;
}

button::after {
  border: none;
}

/* 全局输入框优化 */
input,
textarea {
  caret-color: #1890FF;
}

/* 文本省略 */
.text-ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 清除浮动 */
.clearfix::after {
  content: '';
  display: table;
  clear: both;
}
