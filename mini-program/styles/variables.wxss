/* 全局设计变量 */

/* 主色调 */
page {
  /* 色彩系统 */
  --color-primary: #1890FF;
  --color-primary-light: #E6F7FF;
  --color-primary-dark: #096DD9;

  --color-success: #52C41A;
  --color-success-light: #F6FFED;
  --color-success-dark: #389E0D;

  --color-warning: #FAAD14;
  --color-warning-light: #FFFBE6;
  --color-warning-dark: #D48806;

  --color-danger: #FF4D4F;
  --color-danger-light: #FFF2F0;
  --color-danger-dark: #CF1322;

  --color-info: #1890FF;
  --color-info-light: #E6F7FF;

  /* 文本颜色 */
  --color-text-primary: #1F1F1F;
  --color-text-regular: #333333;
  --color-text-secondary: #666666;
  --color-text-placeholder: #999999;
  --color-text-disabled: #CCCCCC;

  /* 背景颜色 */
  --color-bg-page: #F7F8FA;
  --color-bg-card: #FFFFFF;
  --color-bg-grey: #F5F5F5;
  --color-bg-mask: rgba(0, 0, 0, 0.5);

  /* 边框颜色 */
  --color-border: #EEEEEE;
  --color-border-light: #F5F5F5;
  --color-border-dark: #D9D9D9;

  /* 字体大小 */
  --font-size-xs: 22rpx;
  --font-size-sm: 24rpx;
  --font-size-base: 28rpx;
  --font-size-md: 32rpx;
  --font-size-lg: 36rpx;
  --font-size-xl: 40rpx;

  /* 字体粗细 */
  --font-weight-regular: 400;
  --font-weight-medium: 500;
  --font-weight-semibold: 600;
  --font-weight-bold: 700;

  /* 行高 */
  --line-height-tight: 1.3;
  --line-height-normal: 1.4;
  --line-height-relaxed: 1.6;

  /* 间距 */
  --spacing-xs: 8rpx;
  --spacing-sm: 16rpx;
  --spacing-md: 24rpx;
  --spacing-lg: 32rpx;
  --spacing-xl: 48rpx;

  /* 圆角 */
  --radius-xs: 4rpx;
  --radius-sm: 8rpx;
  --radius-md: 12rpx;
  --radius-lg: 16rpx;
  --radius-round: 50%;

  /* 阴影 */
  --shadow-sm: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  --shadow-md: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  --shadow-lg: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);

  /* 动画时长 */
  --duration-fast: 150ms;
  --duration-normal: 250ms;
  --duration-slow: 350ms;

  /* 动画缓动 */
  --ease-in: cubic-bezier(0.4, 0, 1, 1);
  --ease-out: cubic-bezier(0, 0, 0.2, 1);
  --ease-in-out: cubic-bezier(0.4, 0, 0.2, 1);
}

/* 通用类 */
.container {
  padding: var(--spacing-lg);
  background-color: var(--color-bg-page);
  min-height: 100vh;
}

.card {
  background-color: var(--color-bg-card);
  border-radius: var(--radius-lg);
  padding: var(--spacing-lg);
  margin-bottom: var(--spacing-md);
  box-shadow: var(--shadow-sm);
}

.card-title {
  font-size: var(--font-size-md);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
  margin-bottom: var(--spacing-md);
  padding-bottom: var(--spacing-md);
  border-bottom: 1rpx solid var(--color-border);
}

/* 文本样式 */
.text-primary {
  color: var(--color-primary);
}

.text-success {
  color: var(--color-success);
}

.text-warning {
  color: var(--color-warning);
}

.text-danger {
  color: var(--color-danger);
}

.text-secondary {
  color: var(--color-text-secondary);
}

.text-placeholder {
  color: var(--color-text-placeholder);
}

/* 按钮样式 */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: var(--radius-md);
  font-size: var(--font-size-base);
  font-weight: var(--font-weight-medium);
  transition: opacity var(--duration-fast) var(--ease-out);
}

.btn:active {
  opacity: 0.85;
}

.btn-primary {
  background-color: var(--color-primary);
  color: #FFFFFF;
}

.btn-success {
  background-color: var(--color-success);
  color: #FFFFFF;
}

.btn-warning {
  background-color: var(--color-warning);
  color: #FFFFFF;
}

.btn-danger {
  background-color: var(--color-danger);
  color: #FFFFFF;
}

.btn-secondary {
  background-color: #FFFFFF;
  color: var(--color-primary);
  border: 2rpx solid var(--color-primary);
}

.btn-ghost {
  background-color: transparent;
  color: var(--color-primary);
}

.btn-block {
  width: 100%;
}

.btn-sm {
  height: 64rpx;
  font-size: var(--font-size-sm);
  padding: 0 var(--spacing-lg);
}

.btn-disabled {
  opacity: 0.6;
  pointer-events: none;
}

/* 输入框样式 */
.input-wrapper {
  display: flex;
  align-items: center;
  height: 80rpx;
  background-color: #FFFFFF;
  border: 2rpx solid var(--color-border-dark);
  border-radius: var(--radius-sm);
  padding: 0 var(--spacing-md);
  transition: border-color var(--duration-fast) var(--ease-out),
              box-shadow var(--duration-fast) var(--ease-out);
}

.input-wrapper:focus-within {
  border-color: var(--color-primary);
  box-shadow: 0 0 0 4rpx rgba(24, 144, 255, 0.1);
}

.input-wrapper .input {
  flex: 1;
  height: 100%;
  font-size: var(--font-size-base);
  color: var(--color-text-primary);
}

.input-wrapper .input-placeholder {
  color: var(--color-text-placeholder);
}

/* 文本域样式 */
.textarea-wrapper {
  background-color: #FFFFFF;
  border: 2rpx solid var(--color-border-dark);
  border-radius: var(--radius-sm);
  padding: var(--spacing-md);
  transition: border-color var(--duration-fast) var(--ease-out),
              box-shadow var(--duration-fast) var(--ease-out);
}

.textarea-wrapper:focus-within {
  border-color: var(--color-primary);
  box-shadow: 0 0 0 4rpx rgba(24, 144, 255, 0.1);
}

.textarea-wrapper .textarea {
  width: 100%;
  min-height: 200rpx;
  font-size: var(--font-size-base);
  color: var(--color-text-primary);
  line-height: var(--line-height-relaxed);
}

/* 标签样式 */
.tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 4rpx 16rpx;
  border-radius: var(--radius-xs);
  font-size: var(--font-size-xs);
  font-weight: var(--font-weight-regular);
}

.tag-default {
  background-color: var(--color-bg-grey);
  color: var(--color-text-secondary);
}

.tag-primary {
  background-color: var(--color-primary-light);
  color: var(--color-primary);
}

.tag-success {
  background-color: var(--color-success-light);
  color: var(--color-success);
}

.tag-warning {
  background-color: var(--color-warning-light);
  color: var(--color-warning);
}

.tag-danger {
  background-color: var(--color-danger-light);
  color: var(--color-danger);
}

/* 列表项样式 */
.list-item {
  display: flex;
  align-items: center;
  min-height: 96rpx;
  padding: var(--spacing-md) 0;
  border-bottom: 1rpx solid var(--color-border);
}

.list-item:last-child {
  border-bottom: none;
}

.list-item-label {
  width: 160rpx;
  font-size: var(--font-size-base);
  color: var(--color-text-secondary);
  flex-shrink: 0;
}

.list-item-content {
  flex: 1;
  font-size: var(--font-size-base);
  color: var(--color-text-primary);
}

.list-item-arrow {
  width: 32rpx;
  height: 32rpx;
  color: var(--color-text-disabled);
  margin-left: var(--spacing-sm);
}

/* 表单项样式 */
.form-item {
  margin-bottom: var(--spacing-lg);
}

.form-label {
  font-size: var(--font-size-base);
  color: var(--color-text-secondary);
  margin-bottom: var(--spacing-sm);
}

.form-label-required::before {
  content: '*';
  color: var(--color-danger);
  margin-right: 4rpx;
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-xl) 0;
  color: var(--color-text-placeholder);
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: var(--spacing-md);
}

.empty-text {
  font-size: var(--font-size-base);
}

/* 加载状态 */
.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-xl) 0;
  color: var(--color-text-placeholder);
}

/* 分割线 */
.divider {
  height: 1rpx;
  background-color: var(--color-border);
  margin: var(--spacing-md) 0;
}

/* 弹窗遮罩 */
.popup-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: var(--color-bg-mask);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.popup-content {
  width: 90%;
  max-height: 80vh;
  background-color: var(--color-bg-card);
  border-radius: var(--radius-lg);
  overflow: hidden;
}

.popup-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--spacing-lg);
  border-bottom: 1rpx solid var(--color-border);
}

.popup-title {
  font-size: var(--font-size-md);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
}

.popup-close {
  font-size: 48rpx;
  color: var(--color-text-placeholder);
  padding: var(--spacing-xs);
}

.popup-body {
  max-height: 65vh;
  padding: var(--spacing-lg);
}

/* 底部固定栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: var(--spacing-md);
  padding: var(--spacing-md) var(--spacing-lg);
  background-color: var(--color-bg-card);
  box-shadow: 0 -2rpx 8rpx rgba(0, 0, 0, 0.06);
  z-index: 100;
}

/* 安全区域适配 */
.safe-area-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}
